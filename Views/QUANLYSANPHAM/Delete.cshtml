@model QUANLYBANHANG_MVC.tbSANPHAM

@{
    ViewBag.Title = "Xóa sản phẩm";
    bool daCoTrongHoaDon = ViewBag.DaCoTrongHoaDon == true;
}

<h2>Xóa sản phẩm</h2>

@Html.ValidationSummary(
    false,
    "",
    new { @class = "text-danger" })

@if (daCoTrongHoaDon)
{
    <div class="alert alert-warning">
        Sản phẩm đã được sử dụng trong chi tiết hóa đơn.
        Không được phép xóa để bảo toàn dữ liệu hóa đơn.
    </div>
}
else
{
    <div class="alert alert-danger">
        Bạn có chắc chắn muốn xóa sản phẩm này?
        Thao tác sẽ xóa bản ghi sản phẩm khỏi database.
    </div>
}

<div class="row">
    <div class="col-md-4 mb-3">
        @if (!string.IsNullOrWhiteSpace(Model.HINHANH))
        {
            <img src="@Url.Content("~/images/" + Model.HINHANH)"
                 alt="@Model.TENSANPHAM"
                 style="max-width:100%;height:220px;object-fit:contain;" />
        }
    </div>

    <div class="col-md-8">
        <dl class="row">
            <dt class="col-sm-3">Mã sản phẩm</dt>
            <dd class="col-sm-9">@Model.MASANPHAM</dd>

            <dt class="col-sm-3">Tên sản phẩm</dt>
            <dd class="col-sm-9">@Model.TENSANPHAM</dd>

            <dt class="col-sm-3">Danh mục</dt>
            <dd class="col-sm-9">
                @(Model.tbDANHMUC != null
                    ? Model.tbDANHMUC.TENDANHMUC
                    : "Chưa có danh mục")
            </dd>

            <dt class="col-sm-3">Đơn giá</dt>
            <dd class="col-sm-9">
                @(Model.DONGIA.HasValue
                    ? Model.DONGIA.Value.ToString("N0")
                    : "")
            </dd>

            <dt class="col-sm-3">Số lượng</dt>
            <dd class="col-sm-9">
                @(Model.SOLUONG.HasValue
                    ? Model.SOLUONG.Value.ToString("N0")
                    : "")
            </dd>
        </dl>
    </div>
</div>

@using (Html.BeginForm(
    "Delete",
    "QUANLYSANPHAM",
    new { id = Model.MASANPHAM },
    FormMethod.Post,
    new { @class = "mt-3" }))
{
    @Html.AntiForgeryToken()

    if (!daCoTrongHoaDon)
    {
        <button type="submit" class="btn btn-danger">
            Xác nhận xóa
        </button>
    }

    @Html.ActionLink(
        "Quay lại danh sách",
        "Index",
        null,
        new { @class = "btn btn-secondary" })
}