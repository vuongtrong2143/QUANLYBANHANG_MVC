@using QUANLYBANHANG_MVC
@model QUANLYBANHANG_MVC.tbSANPHAM

@{
    Layout = null;
    ViewBag.Title = "Chi tiết sản phẩm";
    var danhMuc = ViewBag.DanhMuc as System.Collections.Generic.IEnumerable<QUANLYBANHANG_MVC.tbDANHMUC>;
    var gioHang = Session["CART"]
        as QUANLYBANHANG_MVC.Models.CART;

    int tongSoLuong = gioHang != null
        ? gioHang.TotalQuantity()
        : 0;

    decimal tongTien = gioHang != null
        ? gioHang.TotalBill()
        : 0m;
}

<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>@ViewBag.Title</title>

    <link rel="stylesheet"
          type="text/css"
          href="@Url.Content("~/Content/style.css")" />

    <script type="text/javascript"
            src="@Url.Content("~/Scripts/boxOver.js")"></script>
</head>

<body>
    <div id="main_container">

        <!-- ================= TOP BAR ================= -->
        <div class="top_bar">
            <div class="top_search">
                <div class="search_text">
                    <a href="#">Advanced Search</a>
                </div>

                <input type="text"
                       class="search_input"
                       name="search"
                       aria-label="Search" />

                <input type="image"
                       src="@Url.Content("~/images/search.gif")"
                       class="search_bt"
                       alt="Search" />
            </div>

            <div class="languages">
                <div class="lang_text">Languages:</div>

                <a href="#" class="lang">
                    <img src="@Url.Content("~/images/en.gif")"
                         alt="English"
                         border="0" />
                </a>

                <a href="#" class="lang">
                    <img src="@Url.Content("~/images/de.gif")"
                         alt="German"
                         border="0" />
                </a>
            </div>
        </div>

        <!-- ================= HEADER ================= -->
        <div id="header"
             style="width: 1000px;
                    height: 173px;
                    margin: auto;
                    position: relative;
                    z-index: 10;
                    display: flex;
                    align-items: flex-start;
                    box-sizing: border-box;
                    background: url('@Url.Content("~/images/header_bg.jpg")') no-repeat 0 0;">

            <!-- LOGO -->
            <div id="logo"
                 style="float: none;
                        flex: 0 0 267px;
                        padding: 15px;
                        box-sizing: border-box;">

                <a href="@Url.Action("Index", "Trangchu")">
                    <img src="@Url.Content("~/images/logo.png")"
                         alt="Logo"
                         border="0"
                         width="237"
                         height="140"
                         style="display: block;
                                width: 237px;
                                height: 140px;" />
                </a>
            </div>

            <!-- KHỐI QUẢNG CÁO -->
            <div class="oferte_content"
                 style="float: none;
                        flex: 0 0 600px;
                        width: 600px;
                        height: 164px;
                        padding: 0 0 0 50px;
                        display: flex;
                        align-items: flex-start;
                        box-sizing: border-box;">

                <!-- Đường phân cách bên trái -->
                <div class="top_divider"
                     style="float: none;
                            flex: 0 0 1px;
                            width: 1px;
                            height: 164px;">

                    <img src="@Url.Content("~/images/header_divider.png")"
                         alt=""
                         width="1"
                         height="164"
                         style="display: block;" />
                </div>

                <div class="oferta"
                     style="float: none;
                            flex: 0 0 538px;
                            width: 538px;
                            height: 164px;
                            padding: 15px 30px 0;
                            box-sizing: border-box;">

                    <!-- Ảnh bên trái, nội dung bên phải -->
                    <div class="oferta_content"
                         style="display: flex;
                                flex-direction: row;
                                flex-wrap: nowrap;
                                align-items: flex-start;
                                gap: 15px;
                                width: 100%;
                                height: 105px;
                                margin: 0;
                                padding: 0;
                                overflow: visible;
                                box-sizing: border-box;">

                        <img src="@Url.Content("~/images/laptop.png")"
                             alt="Laptop"
                             border="0"
                             width="94"
                             height="92"
                             class="oferta_img"
                             style="display: block;
                                    float: none;
                                    flex: 0 0 94px;
                                    width: 94px;
                                    height: 92px;
                                    margin: 0;
                                    padding: 0;
                                    object-fit: contain;" />

                        <div class="oferta_details"
                             style="float: none;
                                    flex: 1 1 0;
                                    min-width: 0;
                                    width: auto;
                                    margin: 0;
                                    padding: 0;
                                    box-sizing: border-box;">

                            <div class="oferta_title"
                                 style="font-size: 15px;
                                        line-height: 18px;
                                        color: #b72c24;
                                        font-weight: bold;">
                                Samsung GX 2004 LM
                            </div>

                            <div class="oferta_text"
                                 style="padding: 5px 0;
                                        font-size: 12px;
                                        line-height: 15px;
                                        color: #fff;
                                        text-align: justify;">
                                Lorem ipsum dolor sit amet, consectetur adipisicing elit,
                                sed do eiusmod tempor incididunt ut labore et dolore magna aliqua.
                            </div>

                            <a href="#"
                               class="details"
                               style="display: block;
                                      float: none;
                                      width: 83px;
                                      height: 21px;
                                      margin: 5px 0 0 auto;
                                      padding: 0 0 0 5px;
                                      background: url('@Url.Content("~/images/details_bt_bg.gif")') no-repeat center;
                                      text-align: center;
                                      line-height: 21px;
                                      text-decoration: none;
                                      color: #000;
                                      box-sizing: border-box;">
                                details
                            </a>
                        </div>
                    </div>

                    <!-- Phân trang nằm bên dưới ảnh, trong header -->
                    <div class="oferta_pagination"
                         style="display: flex;
                                flex-direction: row;
                                flex-wrap: nowrap;
                                align-items: flex-start;
                                justify-content: flex-start;
                                gap: 3px;
                                float: none;
                                clear: none;
                                width: 100%;
                                height: 24px;
                                margin: 6px 0 0;
                                padding: 0;
                                text-align: left;">

                        <span class="current"
                              style="display: block; float: none; flex: 0 0 25px;
                                     width: 22px; height: 22px; margin: 0; padding: 0;
                                     line-height: 22px; text-align: center; font-size: 10px;">
                            1
                        </span>

                        <a href="#"
                           style="display: block; float: none; flex: 0 0 25px;
                                  width: 22px; height: 22px; margin: 0; padding: 0;
                                  line-height: 22px; text-align: center; font-size: 10px;">
                            2
                        </a>

                        <a href="#"
                           style="display: block; float: none; flex: 0 0 25px;
                                  width: 22px; height: 22px; margin: 0; padding: 0;
                                  line-height: 22px; text-align: center; font-size: 10px;">
                            3
                        </a>

                        <a href="#"
                           style="display: block; float: none; flex: 0 0 25px;
                                  width: 22px; height: 22px; margin: 0; padding: 0;
                                  line-height: 22px; text-align: center; font-size: 10px;">
                            4
                        </a>

                        <a href="#"
                           style="display: block; float: none; flex: 0 0 25px;
                                  width: 22px; height: 22px; margin: 0; padding: 0;
                                  line-height: 22px; text-align: center; font-size: 10px;">
                            5
                        </a>
                    </div>
                </div>

                <!-- Đường phân cách bên phải -->
                <div class="top_divider"
                     style="float: none;
                            flex: 0 0 1px;
                            width: 1px;
                            height: 164px;">

                    <img src="@Url.Content("~/images/header_divider.png")"
                         alt=""
                         width="1"
                         height="164"
                         style="display: block;" />
                </div>
            </div>
        </div>

        <!-- ================= MAIN CONTENT ================= -->
        <div id="main_content">

            <!-- ================= MENU ================= -->
            <div id="menu_tab">
                <div class="left_menu_corner"></div>

                <ul class="menu">
                    <li>
                        <a href="@Url.Action("Index", "Trangchu")" class="nav1">
                            Home
                        </a>
                    </li>
                    <li class="divider"></li>

                    <li><a href="#" class="nav2">Products</a></li>
                    <li class="divider"></li>

                    <li><a href="#" class="nav3">Specials</a></li>
                    <li class="divider"></li>

                    <li><a href="#" class="nav4">My account</a></li>
                    <li class="divider"></li>

                    <li><a href="#" class="nav4">Sign Up</a></li>
                    <li class="divider"></li>

                    <li><a href="#" class="nav5">Shipping</a></li>
                    <li class="divider"></li>

                    <li><a href="#" class="nav6">Contact Us</a></li>
                    <li class="divider"></li>

                    <li class="currencies">
                        Currencies
                        <select aria-label="Currency">
                            <option>US Dollar</option>
                            <option>Euro</option>
                        </select>
                    </li>
                </ul>

                <div class="right_menu_corner"></div>
            </div>

            <!-- ================= BREADCRUMB ================= -->
            <div class="crumb_navigation">
                Navigation:
                <a href="@Url.Action("Index", "Trangchu")">Home</a>
                &gt;
                <span class="current">
                    @if (Model != null)
                    {
                        @Html.DisplayFor(model => model.TENSANPHAM)
                    }
                    else
                    {
                        <text>Chi tiết sản phẩm</text>
                    }
                </span>
            </div>

            <!-- ================= LEFT CONTENT ================= -->
            <div class="left_content">
                <!-- CATEGORIES -->
                <div class="title_box">Categories</div>

                <ul class="left_menu">
                    @{
                        int demDanhMuc = 0;
                    }

                    @if (danhMuc != null)
                    {
                        foreach (var item in danhMuc)
                        {
                            demDanhMuc++;

                            string className = demDanhMuc % 2 == 1
                                ? "odd"
                                : "even";

                            <li class="@className">
                                <a href="#">@item.TENDANHMUC</a>
                            </li>
                        }
                    }
                </ul>

                <!-- SPECIAL PRODUCTS -->
                <div class="title_box">Special Products</div>

                <div class="border_box">
                    <div class="product_title">
                        <a href="#">Motorola 156 MX-VL</a>
                    </div>

                    <div class="product_img">
                        <a href="#">
                            <img src="@Url.Content("~/images/laptop.png")"
                                 alt="Motorola 156 MX-VL"
                                 border="0" />
                        </a>
                    </div>

                    <div class="prod_price">
                        <span class="reduce">350$</span>
                        <span class="price">270$</span>
                    </div>
                </div>

                <!-- NEWSLETTER -->
                <div class="title_box">Newsletter</div>

                <div class="border_box">
                    <input type="email"
                           name="newsletter"
                           class="newsletter_input"
                           placeholder="Your email"
                           aria-label="Newsletter email" />

                    <a href="#" class="join">join</a>
                </div>

                <div class="banner_adds">
                    <a href="#">
                        <img src="@Url.Content("~/images/bann2.jpg")"
                             alt="Advertisement"
                             border="0" />
                    </a>
                </div>
            </div>

            <!-- ================= CENTER CONTENT ================= -->
            <div class="center_content">
                <div class="center_title_bar">Chi tiết sản phẩm</div>

                @if (Model == null)
                {
                    <div style="clear: both; padding: 15px; color: #b72c24;">
                        Không tìm thấy sản phẩm.
                    </div>

                    <a href="@Url.Action("Index", "Trangchu")"
                       style="display: inline-block; margin: 10px 15px;">
                        Quay lại trang chủ
                    </a>
                }
                else
                {
                    <!-- Khung chi tiết sản phẩm -->
                    <div class="prod_box_big">
                        <div class="top_prod_box_big"></div>

                        <div class="center_prod_box_big"
                             style="display: flex;
                                    align-items: flex-start;
                                    float: none;
                                    clear: both;
                                    padding: 15px 0;">

                            <!-- Ảnh sản phẩm -->
                            <div class="product_img_big"
                                 style="float: none;
                                        flex: 0 0 170px;
                                        width: 170px;
                                        padding: 5px 10px;
                                        box-sizing: border-box;">

                                @if (!string.IsNullOrWhiteSpace(Model.HINHANH))
                                {
                                    <img src="@Url.Content("~/images/" + Model.HINHANH)"
                                         alt="@Model.TENSANPHAM"
                                         style="display: block;
                                                width: 150px;
                                                height: 150px;
                                                margin: 0 auto;
                                                object-fit: contain;" />
                                }
                                else
                                {
                                    <div style="padding: 20px 0; color: #999;">
                                        Chưa có hình ảnh
                                    </div>
                                }
                            </div>

                            <!-- Thông tin sản phẩm -->
                            <div class="details_big_box"
                                 style="float: none;
                                        flex: 1 1 0;
                                        min-width: 0;
                                        width: auto;
                                        padding: 0 15px;
                                        text-align: left;
                                        box-sizing: border-box;">

                                <div class="product_title_big">
                                    @Html.DisplayFor(model => model.TENSANPHAM)
                                </div>

                                <div class="prod_price_big">
                                    Giá:
                                    <span class="price">
                                        @Html.DisplayFor(model => model.DONGIA) $
                                    </span>
                                </div>
                                <!-- THÊM VÀO GIỎ HÀNG: đặt ngay dưới giá -->
                                @using (Html.BeginForm(
                                    "ThemVaoGio",
                                    "GioHang",
                                    FormMethod.Post,
                                    new
                                    {
                                        style = "margin-top:12px; clear:both;"
                                    }))
                                {
                                    @Html.AntiForgeryToken()

                                    <!-- Mã của sản phẩm đang xem -->
                                    <input type="hidden"
                                           name="id"
                                           value="@Model.MASANPHAM" />

                                    <div style="display:flex;
                align-items:center;
                flex-wrap:wrap;
                gap:8px;">

                                        <label for="soLuong">
                                            Số lượng:
                                        </label>

                                        <input type="number"
                                               id="soLuong"
                                               name="soLuong"
                                               value="1"
                                               min="1"
                                               step="1"
                                               required
                                               style="width:65px; padding:5px;" />

                                        <button type="submit"
                                                style="padding:6px 12px;
                       border:1px solid #2874a6;
                       background:#2874a6;
                       color:#fff;
                       cursor:pointer;">
                                            Thêm vào giỏ hàng
                                        </button>
                                    </div>
                                }
                                <!-- Chưa kết nối chức năng giỏ hàng -->

                                <a href="@Url.Action("Index", "Trangchu")"
                                   style="display: inline-block;
                                          margin-top: 15px;
                                          color: #0fa0dd;
                                          text-decoration: none;">
                                    &larr; Quay lại trang chủ
                                </a>
                            </div>
                        </div>

                        <div class="bottom_prod_box_big"></div>
                    </div>
                }
            </div>

            <!-- ================= RIGHT CONTENT ================= -->
            <div class="right_content">

                <!-- SHOPPING CART: giao diện mẫu -->
                <!-- SHOPPING CART -->
                <div class="shopping_cart">
                    <div class="cart_title">Giỏ hàng</div>

                    <div class="cart_details">
                        @tongSoLuong sản phẩm
                        <span class="border_cart"></span>

                        Tổng tiền:
                        <span class="price">
                            @tongTien.ToString("N0")
                        </span>
                    </div>

                    <div class="cart_icon">
                        <a href="@Url.Action("Index", "GioHang")"
                           title="Xem giỏ hàng">
                            <img src="@Url.Content("~/images/shoppingcart.png")"
                                 alt="Xem giỏ hàng"
                                 width="48"
                                 height="48"
                                 border="0" />
                        </a>
                    </div>
                </div>

                <!-- WHAT'S NEW -->
                <div class="title_box">What's new</div>

                <div class="border_box">
                    <div class="product_title">
                        <a href="#">Motorola 156 MX-VL</a>
                    </div>

                    <div class="product_img">
                        <a href="#">
                            <img src="@Url.Content("~/images/p2.gif")"
                                 alt="Motorola 156 MX-VL"
                                 border="0" />
                        </a>
                    </div>

                    <div class="prod_price">
                        <span class="reduce">350$</span>
                        <span class="price">270$</span>
                    </div>
                </div>

                <!-- MANUFACTURERS -->
                <div class="title_box">Manufacturers</div>

                <ul class="left_menu">
                    <li class="odd"><a href="#">Sony</a></li>
                    <li class="even"><a href="#">Samsung</a></li>
                    <li class="odd"><a href="#">Daewoo</a></li>
                    <li class="even"><a href="#">LG</a></li>
                    <li class="odd"><a href="#">Fujitsu Siemens</a></li>
                    <li class="even"><a href="#">Motorola</a></li>
                    <li class="odd"><a href="#">Phillips</a></li>
                    <li class="even"><a href="#">Beko</a></li>
                </ul>

                <div class="banner_adds">
                    <a href="#">
                        <img src="@Url.Content("~/images/bann1.jpg")"
                             alt="Advertisement"
                             border="0" />
                    </a>
                </div>
            </div>
        </div>

        <!-- ================= FOOTER ================= -->
        <div class="footer">
            <div class="left_footer">
                <img src="@Url.Content("~/images/footer_logo.png")"
                     alt="Footer logo"
                     width="170"
                     height="49" />
            </div>

            <div class="center_footer">
                Template name. All Rights Reserved 2008
                <br />

                <a href="https://csscreme.com">
                    <img src="@Url.Content("~/images/csscreme.jpg")"
                         alt="csscreme"
                         border="0" />
                </a>

                <br />

                <img src="@Url.Content("~/images/payment.gif")"
                     alt="Payment methods" />
            </div>

            <div class="right_footer">
                <a href="@Url.Action("Index", "Trangchu")">home</a>
                <a href="#">about</a>
                <a href="#">sitemap</a>
                <a href="#">rss</a>
                <a href="#">contact us</a>
            </div>
        </div>
    </div>
</body>
</html>